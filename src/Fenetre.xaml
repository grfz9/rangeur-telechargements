<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rangeur de Téléchargements"
        Width="760" Height="540" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9CDD4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- Bouton principal ; texte grisé quand il est désactivé pour rester lisible. -->
        <Style x:Key="Primaire" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dossier à ranger -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E1E4E8" BorderThickness="1"
                CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <Button x:Name="BtnChanger" DockPanel.Dock="Right" Content="Changer…" Margin="12,0,0,0"/>
                <TextBlock Text="Dossier" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtDossier" VerticalAlignment="Center" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Aperçu -->
        <ListView x:Name="ListeApercu" Grid.Row="1" BorderBrush="#E1E4E8" Background="White">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Fichier" Width="460" DisplayMemberBinding="{Binding Nom}"/>
                    <GridViewColumn Header="Ira dans" Width="200" DisplayMemberBinding="{Binding Categorie}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="BtnRanger" Content="Ranger" Style="{StaticResource Primaire}"/>
            <Button x:Name="BtnAnnuler" Content="Annuler le dernier rangement"/>
            <Button x:Name="BtnCategories" Content="Catégories…"/>
        </StackPanel>

        <!-- État -->
        <TextBlock x:Name="TxtEtat" Grid.Row="3" Margin="2,12,0,0" Foreground="#374151" TextWrapping="Wrap"/>
    </Grid>
</Window>
